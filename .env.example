# Copy to .env for local development. Do NOT commit .env.

# Telegram
TELEGRAM_TOKEN=123456:abc...
ALLOWED_CHAT_IDS=12345678

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-5

# Intervals.icu
INTERVALS_API_KEY=...
INTERVALS_ATHLETE_ID=i12345

# WHOOP (optional — leave blank to skip WHOOP)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=

# Athlete profile
ATHLETE_NAME=Alex
ATHLETE_FTP=250
ATHLETE_GOAL=Build cycling fitness consistently for spring sportive
ATHLETE_TIMEZONE=Europe/London

# Daily briefing time (athlete's local timezone, 24h)
BRIEFING_HOUR=6
BRIEFING_MINUTE=30

# SQLite path (local dev override)
DB_PATH=./data/coach.db
